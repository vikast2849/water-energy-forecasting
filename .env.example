# Flask Secret Key for Session Signing (Set to a strong random string in production)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# Demo User Access Passwords
DEMO_OFFICER_PASSWORD=change-to-secure-officer-password
DEMO_RESEARCHER_PASSWORD=change-to-secure-researcher-password
DEMO_ADMIN_PASSWORD=change-to-secure-admin-password

# Application Port (Render sets this dynamically via $PORT)
PORT=5000
